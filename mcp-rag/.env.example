# Point at local Ollama + Qdrant (see docker-compose.example.yml)
OLLAMA_URL=http://127.0.0.1:11434
QDRANT_URL=http://127.0.0.1:6333
EMBEDDING_MODEL=nomic-embed-text
# nomic-embed-text vector size; leave blank to detect from first embed
EMBEDDING_DIM=768
QDRANT_COLLECTION=ops_knowledge
# Optional defaults for tools when args omit them
DEFAULT_PROJECT_ID=ops-agent
